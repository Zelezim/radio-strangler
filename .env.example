# Copy to .env and fill in. Never commit .env.

# Postgres connection string. For Supabase use the SESSION pooler (port 5432), not the
# transaction pooler: migrations rely on pg_advisory_lock, which needs a stable session.
DATABASE_URL=

# Base URL of the legacy PHP station API.
LEGACY_URL=http://localhost:8081

# Bearer token for the admin endpoints that change route modes.
ADMIN_TOKEN=change-me

# Demo only: makes the Go API diverge on purpose so shadow mode has mismatches to show.
DEMO_INJECT_BUGS=true

# debug | info | warn | error
LOG_LEVEL=info

# Optional tuning (defaults shown).
# LEGACY_TIMEOUT=60s
# RULES_REFRESH=5s
# SHADOW_WORKERS=4
# SHADOW_QUEUE=100
# SHADOW_TIMEOUT=5s
# SHADOW_RETENTION=168h
